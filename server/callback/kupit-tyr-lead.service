[Unit]
Description=kupit-tyr lead form backend (loopback only)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
ExecStart=/usr/bin/python3 /opt/kupit-tyr-lead/app.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/log/kupit-tyr-lead

[Install]
WantedBy=multi-user.target
